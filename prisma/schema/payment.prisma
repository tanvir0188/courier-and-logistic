model Payment {
  id         String   @id @default(uuid())
  shipmentId String   @unique @map("shipment_id")
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id")
  customer   User     @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Restrict)

  transactionId String?        @unique @map("transaction_id")
  gateway       PaymentGateway @default(STRIPE)
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(PENDING)

  gatewayReference String?   @map("gateway_reference")
  callbackData     Json?     @map("callback_data")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@map("payments")
}
