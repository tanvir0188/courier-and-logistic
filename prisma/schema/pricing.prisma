model PricingRule {
  id                 String       @id @default(uuid())
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  baseFee            Decimal      @db.Decimal(10, 2)
  perKgFee           Decimal      @db.Decimal(10, 2)
  distanceMultiplier Decimal      @db.Decimal(10, 2)
  minWeightKg        Float        @default(0)
  maxWeightKg        Float?
  zoneFromId         String?
  zoneFrom           Zone?        @relation("PricingFromZone", fields: [zoneFromId], references: [id], onDelete: SetNull)
  zoneToId           String?
  zoneTo             Zone?        @relation("PricingToZone", fields: [zoneToId], references: [id], onDelete: SetNull)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orgId])
  @@index([orgId, zoneFromId, zoneToId])
  @@map("pricing_rules")
}
