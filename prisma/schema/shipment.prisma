model Shipment {
  id                String   @id @default(uuid())
  trackingNumber    String   @unique @map("tracking_number")
  customerId        String   @map("customer_id")
  customer          User     @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: Restrict)
  providerId        String   @map("provider_id")
  provider          User     @relation("ProviderShipments", fields: [providerId], references: [id], onDelete: Restrict)
  pickupCourierId   String?  @map("pickup_courier_id")
  pickupCourier     Courier? @relation("PickupCourierShipments", fields: [pickupCourierId], references: [id], onDelete: SetNull)
  deliveryCourierId String?  @map("delivery_courier_id")
  deliveryCourier   Courier? @relation("DeliveryCourierShipments", fields: [deliveryCourierId], references: [id], onDelete: SetNull)

  senderZoneId   String @map("sender_zone_id")
  senderZone     Zone   @relation("SenderZoneShipments", fields: [senderZoneId], references: [id], onDelete: Restrict)
  receiverZoneId String @map("receiver_zone_id")
  receiverZone   Zone   @relation("ReceiverZoneShipments", fields: [receiverZoneId], references: [id], onDelete: Restrict)

  senderName    String @map("sender_name")
  senderPhone   String @map("sender_phone")
  senderAddress String @map("sender_address")

  receiverName    String @map("receiver_name")
  receiverPhone   String @map("receiver_phone")
  receiverAddress String @map("receiver_address")

  parcelDescription String? @map("parcel_description")
  weight            Float
  quantity          Int     @default(1)

  deliveryFee Decimal @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  status    ShipmentStatus @default(CREATED)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  payment Payment?
  events  ShipmentEvent[]

  @@index([customerId])
  @@index([providerId, status])
  @@index([pickupCourierId])
  @@index([deliveryCourierId])
  @@map("shipments")
}

model ShipmentEvent {
  id          String         @id @default(uuid())
  shipmentId  String         @map("shipment_id")
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([shipmentId])
  @@map("shipment_events")
}
