model Courier {
  id         String        @id @default(uuid())
  providerId String        @map("provider_id")
  provider   User          @relation("ProviderCouriers", fields: [providerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  zoneId     String        @map("zone_id")
  zone       Zone          @relation("ZoneCouriers", fields: [zoneId], references: [id], onDelete: Cascade)
  status     CourierStatus @default(AVAILABLE)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  pickupShipments   Shipment[] @relation("PickupCourierShipments")
  deliveryShipments Shipment[] @relation("DeliveryCourierShipments")

  @@index([providerId])
  @@index([status])
  @@map("couriers")
}
