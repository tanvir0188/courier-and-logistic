model Hub {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  code         String
  address      String
  city         String
  postalCode   String?
  latitude     Float
  longitude    Float
  phone        String?
  email        String?
  managerId    String?
  manager      User?        @relation("HubManager", fields: [managerId], references: [id], onDelete: SetNull)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  zones                Zone[]
  originShipments      Shipment[]       @relation("OriginHub")
  destinationShipments Shipment[]       @relation("DestinationHub")
  currentShipments     Shipment[]       @relation("CurrentHub")
  trackingEvents       TrackingEvent[]
  stationedCouriers    CourierProfile[] @relation("HubStationedCouriers")

  @@unique([orgId, code])
  @@index([orgId])
  @@index([latitude, longitude])
  @@map("hubs")
}

model Zone {
  id                 String       @id @default(uuid())
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hubId              String?
  hub                Hub?         @relation(fields: [hubId], references: [id], onDelete: SetNull)
  name               String
  code               String
  description        String?
  city               String
  postalCodes        String[]     @default([])
  polygonCoordinates Json?
  rateMultiplier     Float        @default(1.0)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  pickupShipments   Shipment[]    @relation("PickupZone")
  deliveryShipments Shipment[]    @relation("DeliveryZone")
  pricingRulesFrom  PricingRule[] @relation("PricingFromZone")
  pricingRulesTo    PricingRule[] @relation("PricingToZone")

  @@unique([orgId, code])
  @@index([orgId, hubId])
  @@map("zones")
}
